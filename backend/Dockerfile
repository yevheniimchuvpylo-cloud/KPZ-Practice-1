# 1. Беремо базовий образ з Node.js
FROM node:20-alpine

# 2. Створюємо папку всередині контейнера, де буде жити код
WORKDIR /app

# 3. Копіюємо файли зі списком бібліотек
COPY package*.json ./

# 4. Встановлюємо бібліотеки
RUN npm install

# 5. Копіюємо решту коду
COPY . .

# 6. Кажемо, який порт відкрити (наприклад, 3000)
EXPOSE 3000

# 7. Команда для запуску сервера
CMD ["node", "index.js"]